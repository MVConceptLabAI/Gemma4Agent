# V19 Gemma Fast runtime. Copy to .env and never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CAPTION_ENGINE=gemma_fast
GEMMA_FAST_MODEL=google/gemma-4-31b-it
GEMMA_FAST_MAX_TOKENS=700
NUM_FRAMES=24
FRAME_MAX_EDGE=640
SCENE_DETECT_ENABLED=0
TIMESTAMP_FRAMES=0
MAX_CONCURRENCY=3
PER_TASK_TIMEOUT_S=120
GLOBAL_BUDGET_S=480
MAX_CAPTION_CHARS=500
TRUST_GENERATED_HUMOROUS_TECH=1
