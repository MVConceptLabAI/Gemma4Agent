# V20.4 submission runtime. Copy to .env and never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CAPTION_ENGINE=gemma_hybrid
GEMMA_FAST_MODEL=google/gemma-4-31b-it
