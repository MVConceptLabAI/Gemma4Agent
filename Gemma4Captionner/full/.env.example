# Copy to .env for local runs. Never commit real keys.

FIREWORKS_API_KEY=fw_xxx
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Experimental only; leave unset to preserve the existing runtime selection.
# CAPTION_ENGINE=qwen_direct
QWEN_DIRECT_MODEL=accounts/fireworks/models/qwen3p7-plus
QWEN_DIRECT_HTTP_TIMEOUT_S=45
QWEN_DIRECT_STYLE_CONCURRENCY=1
QWEN_DIRECT_RETRY_MAX_DELAY_S=4
QWEN_DIRECT_RETRY_JITTER_CAP_S=0.35
# Optional direct-engine prompt ablation; default v1 remains unchanged.
# QWEN_DIRECT_PROMPT_PROFILE=strong_v2
PROVIDER_ORDER=openrouter,fireworks
DESCRIBE_PROVIDER_ORDER=openrouter,fireworks
STYLE_PROVIDER_ORDER=openrouter,fireworks
VLM_MODEL=accounts/fireworks/models/qwen2p5-vl-7b-instruct
VLM_FALLBACK_MODELS=accounts/fireworks/models/qwen2p5-vl-32b-instruct,accounts/fireworks/models/minimax-m3
DIRECT_VIDEO_MODEL=
DIRECT_VIDEO_MAX_SECONDS=60
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VLM_MODEL=qwen/qwen3-vl-8b-instruct
DESCRIBE_MAX_TOKENS=700
STYLE_MODEL=accounts/fireworks/models/gemma-3-27b-it
STYLE_LORA=
STYLE_FALLBACK_MODELS=accounts/fireworks/models/minimax-m3
OPENROUTER_STYLE_MODEL=qwen/qwen3-vl-8b-instruct
STYLE_MAX_TOKENS=140

# Local judge proxy. Uses the first provider with an available key.
JUDGE_PROVIDER_ORDER=fireworks,openrouter
OPENROUTER_JUDGE_MODEL=qwen/qwen3-vl-8b-instruct

# Audio transcription is disabled in the submission image: the active
# providers are OpenRouter and Fireworks only.
AUDIO_TRANSCRIBE_ENABLED=0
# Visual observers first create a grounding context. Gemma 4 then receives a
# compact copy of the source video (including audio) and validates only facts
# supported by both sources. This does not use Groq/Whisper.
VIDEO_CONTEXT_OBSERVER=google/gemma-4-31b-it
VIDEO_CONTEXT_MAX_BYTES=14000000

NUM_FRAMES=8
FRAME_MAX_EDGE=720
SCENE_DETECT_ENABLED=1
SCENE_THRESHOLD=0.35
MAX_CONCURRENCY=3
PER_TASK_TIMEOUT_S=25
